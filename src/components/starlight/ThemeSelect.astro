---

---

<button
    type="button"
    aria-label="切换明暗主题"
    class="sl-theme-toggle border-primary/40 bg-card/80 text-primary hover:bg-primary hover:text-primary-foreground flex h-9 w-9 items-center justify-center rounded-full border backdrop-blur-sm transition-colors">
    <svg
        class="light-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
    <svg
        class="dark-icon hidden"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
</button>

<script is:inline>
    (function () {
        const html = document.documentElement;

        function syncIcons() {
            const isDark = html.dataset.theme === "dark";
            // 同步当前 DOM 中所有的主题切换按钮（Header 与移动端菜单各渲染一次）
            document.querySelectorAll(".sl-theme-toggle").forEach((btn) => {
                btn.querySelector(".light-icon")?.classList.toggle("hidden", isDark);
                btn.querySelector(".dark-icon")?.classList.toggle("hidden", !isDark);
            });
        }

        function setTheme(theme) {
            html.dataset.theme = theme;
            html.classList.toggle("dark", theme === "dark");
            localStorage.setItem("theme", theme);
            localStorage.setItem("starlight-theme", theme);
            if (window.StarlightThemeProvider) {
                window.StarlightThemeProvider.updatePickers(theme);
            }
            syncIcons();
        }

        // 每次组件渲染时同步主题类与图标（内联脚本会随组件实例执行多次）
        html.classList.toggle("dark", html.dataset.theme === "dark");
        syncIcons();

        // 全局监听器仅注册一次：使用事件委托兼容多实例按钮
        if (!window.__slThemeToggleReady) {
            window.__slThemeToggleReady = true;

            document.addEventListener("click", (e) => {
                const target = e.target;
                if (!(target instanceof Element)) return;
                const btn = target.closest(".sl-theme-toggle");
                if (!btn) return;
                const next = html.dataset.theme === "dark" ? "light" : "dark";
                setTheme(next);
            });

            // 监听系统主题变化（当 storage 中没有明确设置时）
            const mql = matchMedia("(prefers-color-scheme: light)");
            mql.addEventListener("change", () => {
                const stored = localStorage.getItem("starlight-theme") || localStorage.getItem("theme");
                if (!stored || stored === "auto") {
                    setTheme(mql.matches ? "light" : "dark");
                }
            });
        }
    })();
</script>
