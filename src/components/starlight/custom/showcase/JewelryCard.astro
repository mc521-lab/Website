---
export interface Props {
    jewelry: {
        id: string;
        name: string;
        type: string;
        applicableClass: string;
        features: Array<{
            id: string;
            name: string;
            values: Array<{
                id: string;
                name: string;
                value: number[];
            }>;
        }>;
        jobId: string;
        jobName: string;
        jobColor: string;
        slotType: string;
        isTreasure: boolean;
    };
}

const { jewelry } = Astro.props;
---

<article
    class="gufeng-card gufeng-corner relative flex h-full flex-col gap-3 p-5"
    data-item
    data-name={jewelry.name}
    data-job={jewelry.jobId}
    data-slot={jewelry.slotType}>
    <div class="flex items-start justify-between gap-2">
        <h3 class="gufeng-kai text-foreground text-lg leading-tight font-semibold mt-0!">
            {jewelry.name}
        </h3>
    </div>

    <div class="flex flex-wrap gap-2">
        <span class="gufeng-seal-sm" style={`border-color: ${jewelry.jobColor}; color: ${jewelry.jobColor};`}>
            {jewelry.jobName}
        </span>
        <span class="gufeng-seal-sm border-border text-muted-foreground">
            {jewelry.slotType}
        </span>
    </div>

    {
        jewelry.features && jewelry.features.length > 0 && (
            <div class="border-border mt-auto space-y-2! border-t pt-3">
                {jewelry.features.map((feature) => (
                    <div>
                        <p class="gufeng-song text-muted-foreground mb-1 text-sm">{feature.name}</p>
                        <div class="flex flex-wrap gap-2! mt-1!">
                            {feature.values.map((val) => (
                                <span class="gufeng-seal-sm border-border text-muted-foreground text-[12px]!">
                                    {val.name}: {val.value[0]} - {val.value[1]}
                                </span>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        )
    }
</article>
