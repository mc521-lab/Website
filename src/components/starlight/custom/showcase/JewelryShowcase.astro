---
import fs from "node:fs";
import path from "node:path";
import JewelryCard from "./JewelryCard.astro";

const dataPath = path.resolve("public/data/wiki/jewelries.json");
const raw = fs.readFileSync(dataPath, "utf-8");
const data = JSON.parse(raw);

const jobs = data.manifest?.metadata?.jobEntries || [];
const jewelries = data.jewelries || [];

const slotTypes = Array.from(new Set(jewelries.map((j: any) => j.slotType))) as string[];
---

<div id="jewelry-showcase" class="not-content space-y-6" data-jewelry-showcase>
    <div class="jewelry-filters">
        <div class="filter-group">
            <input
                data-search
                type="text"
                placeholder="搜索饰品名称..."
                class="gufeng-song jewelry-search"
            />
        </div>
        <div class="filter-group">
            <span class="filter-label gufeng-kai">职业:</span>
            <div class="filter-buttons">
                <button data-job-filter="all" class="gufeng-kai filter-btn active">全部</button>
                {
                    jobs.map((job: { id: string; name: string; symbolColor: string }) => (
                        <button data-job-filter={job.id} class="gufeng-kai filter-btn">
                            {job.name}
                        </button>
                    ))
                }
            </div>
        </div>
        <div class="filter-group">
            <span class="filter-label gufeng-kai">部位:</span>
            <div class="filter-buttons">
                <button data-slot-filter="all" class="gufeng-kai filter-btn active">全部</button>
                {
                    slotTypes.map((slot: string) => (
                        <button data-slot-filter={slot} class="gufeng-kai filter-btn">
                            {slot}
                        </button>
                    ))
                }
            </div>
        </div>
    </div>

    <div class="not-content grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {jewelries.map((jewelry: any) => <JewelryCard jewelry={jewelry} />)}
    </div>

    <div class="jewelry-empty" data-empty-state>
        <p class="gufeng-kai">未找到符合条件的饰品</p>
    </div>
</div>

<script>
    (function () {
        const container = document.querySelector("[data-jewelry-showcase]");
        if (!container) return;
        const searchInput = container.querySelector("[data-search]") as HTMLInputElement | null;
        const jobFilterButtons = container.querySelectorAll("[data-job-filter]");
        const slotFilterButtons = container.querySelectorAll("[data-slot-filter]");
        const items = container.querySelectorAll("[data-item]");
        const emptyState = container.querySelector("[data-empty-state]") as HTMLElement | null;
        let activeJobFilter = "all";
        let activeSlotFilter = "all";

        function filter() {
            const query = (searchInput ? searchInput.value : "").toLowerCase().trim();
            let visibleCount = 0;
            items.forEach((item) => {
                const name = (item.getAttribute("data-name") || "").toLowerCase();
                const job = item.getAttribute("data-job") || "";
                const slot = item.getAttribute("data-slot") || "";
                const matchesSearch = !query || name.includes(query);
                const matchesJob = activeJobFilter === "all" || job === activeJobFilter;
                const matchesSlot = activeSlotFilter === "all" || slot === activeSlotFilter;
                const visible = matchesSearch && matchesJob && matchesSlot;
                (item as HTMLElement).style.display = visible ? "" : "none";
                if (visible) visibleCount++;
            });
            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? "" : "none";
            }
        }

        if (searchInput) searchInput.addEventListener("input", filter);
        jobFilterButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                activeJobFilter = btn.getAttribute("data-job-filter") || "all";
                jobFilterButtons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                filter();
            });
        });
        slotFilterButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                activeSlotFilter = btn.getAttribute("data-slot-filter") || "all";
                slotFilterButtons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                filter();
            });
        });
    })();
</script>

<style>
    .jewelry-filters {
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: var(--card);
        border: 1px solid var(--border);
        position: relative;
    }
    @media (min-width: 768px) {
        .jewelry-filters {
            flex-direction: row;
            align-items: center;
        }
    }
    .jewelry-filters::before {
        content: "";
        position: absolute;
        inset: 5px;
        border: 1px solid var(--border);
        pointer-events: none;
        opacity: 0.4;
    }
    .filter-group {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        flex-wrap: wrap;
        position: relative;
        z-index: 1;
    }
    .jewelry-search {
        width: 100%;
        max-width: 24rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border);
        background: var(--background);
        color: var(--foreground);
        font-size: 0.875rem;
        outline: none;
        transition: border-color 0.2s ease;
    }
    .jewelry-search:focus {
        border-color: var(--primary);
    }
    .filter-label {
        font-size: 0.875rem;
        color: var(--foreground);
        white-space: nowrap;
    }
    .filter-buttons {
        display: flex;
        gap: 0.375rem;
        flex-wrap: wrap;
    }
    .filter-btn {
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--foreground);
        font-size: 0.8125rem;
        cursor: pointer;
        transition: all 0.2s ease;
        border-radius: 2px;
    }
    .filter-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
    }
    .filter-btn.active {
        background: var(--primary);
        border-color: var(--primary);
        color: var(--primary-foreground);
    }
    .jewelry-empty {
        display: none;
        text-align: center;
        padding: 3rem 1rem;
        color: var(--muted-foreground);
        font-size: 1rem;
    }
</style>
