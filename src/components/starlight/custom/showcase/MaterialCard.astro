---
interface Material {
    id: string;
    name: string;
    quality: string;
    type: string;
    description: string;
    effect: string;
    source: string;
    image: string | null;
}

interface Props {
    material: Material;
}

const { material } = Astro.props;

const qualityColorMap: Record<string, string> = {
    普通: "#8b7e6b",
    精良: "#63bbd0",
    稀有: "#eb507e",
    史诗: "#fbda41",
    C: "#8b7e6b",
    B: "#63bbd0",
    A: "#eb507e",
    S: "#fbda41",
};

const qualityColor = qualityColorMap[material.quality] || "var(--muted-foreground)";

const imageUrl = material.image ? `/wiki/itemwiki/${material.image}` : null;
---

<div
    class="gufeng-card gufeng-corner flex flex-col gap-3 p-5 h-full"
    data-item
    data-name={material.name}
    data-description={material.description}>
    <div class="flex items-start justify-between gap-3">
        <h3 class="gufeng-kai text-foreground text-lg font-semibold">
            {material.name}
        </h3>
        <div class="flex shrink-0 items-center gap-2">
            <span
                class="gufeng-seal-sm"
                style={`color: ${qualityColor}; border-color: ${qualityColor}; background-color: color-mix(in srgb, ${qualityColor} 12%, transparent);`}>
                {material.quality}
            </span>
            <span class="gufeng-seal-sm border-border bg-secondary text-muted-foreground">
                {material.type}
            </span>
        </div>
    </div>

    {
        imageUrl && (
            <div class="flex justify-center">
                <img src={imageUrl} alt={material.name} class="rendering-pixelated h-16 w-16 object-contain" loading="lazy" />
            </div>
        )
    }

    <div class="gufeng-song text-muted-foreground text-sm leading-relaxed">
        {
            material.description.split("\n").map((line, i) => (
                <>
                    {i > 0 && <br />}
                    {line}
                </>
            ))
        }
    </div>

    {material.effect && <div class="gufeng-song text-accent text-sm">{material.effect}</div>}

    {
        material.source && (
            <div class="gufeng-song border-border text-muted-foreground mt-auto border-t pt-2 text-xs">
                来源：{material.source}
            </div>
        )
    }
</div>
