---
import fs from "node:fs";
import path from "node:path";
import WeaponCard from "./WeaponCard.astro";

const dataPath = path.resolve("public/data/wiki/equipment.json");
const raw = fs.readFileSync(dataPath, "utf-8");
const data = JSON.parse(raw);

const jobs = [
    { id: "zhanshi", name: "战士" },
    { id: "fashi", name: "法师" },
    { id: "cike", name: "刺客" },
    { id: "mushi", name: "牧师" },
    { id: "sheshou", name: "射手" },
];
---

<div id="weapon-showcase" class="not-content" data-weapon-showcase>
    <div class="weapon-filters">
        <div class="filter-group">
            <input
                type="text"
                data-search
                placeholder="搜索武器名称..."
                class="gufeng-song weapon-search"
            />
        </div>
        <div class="filter-group">
            <span class="filter-label gufeng-kai">职业:</span>
            <div class="filter-buttons">
                <button data-filter="all" class="gufeng-kai filter-btn active">全部</button>
                {
                    jobs.map((job) => (
                        <button data-filter={job.id} class="gufeng-kai filter-btn">
                            {job.name}
                        </button>
                    ))
                }
            </div>
        </div>
    </div>

    <div class="not-content grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {data.weapons.map((weapon: any) => <WeaponCard weapon={weapon} />)}
    </div>

    <div class="weapon-empty" data-empty-state>
        <p class="gufeng-kai">未找到符合条件的武器</p>
    </div>
</div>

<script>
    (function () {
        const container = document.querySelector("[data-weapon-showcase]");
        if (!container) return;
        const searchInput = container.querySelector("[data-search]") as HTMLInputElement | null;
        const filterButtons = container.querySelectorAll("[data-filter]") as NodeListOf<HTMLElement>;
        const items = container.querySelectorAll("[data-item]") as NodeListOf<HTMLElement>;
        const emptyState = container.querySelector("[data-empty-state]") as HTMLElement | null;
        let activeFilter = "all";

        function filter() {
            const query = (searchInput ? searchInput.value : "").toLowerCase().trim();
            let visibleCount = 0;
            items.forEach((item) => {
                const name = (item.dataset.name || "").toLowerCase();
                const category = item.dataset.category || "";
                const matchesSearch = !query || name.includes(query);
                const matchesFilter = activeFilter === "all" || category === activeFilter;
                const visible = matchesSearch && matchesFilter;
                item.style.display = visible ? "" : "none";
                if (visible) visibleCount++;
            });
            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? "" : "none";
            }
        }

        if (searchInput) searchInput.addEventListener("input", filter);
        filterButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                activeFilter = btn.dataset.filter || "all";
                filterButtons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                filter();
            });
        });
    })();
</script>

<style>
    .weapon-filters {
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: var(--card);
        border: 1px solid var(--border);
        position: relative;
    }
    @media (min-width: 768px) {
        .weapon-filters {
            flex-direction: row;
            align-items: center;
        }
    }
    .weapon-filters::before {
        content: "";
        position: absolute;
        inset: 5px;
        border: 1px solid var(--border);
        pointer-events: none;
        opacity: 0.4;
    }
    .filter-group {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        flex-wrap: wrap;
        position: relative;
        z-index: 1;
    }
    .weapon-search {
        width: 100%;
        max-width: 24rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border);
        background: var(--background);
        color: var(--foreground);
        font-size: 0.875rem;
        outline: none;
        transition: border-color 0.2s ease;
    }
    .weapon-search:focus {
        border-color: var(--primary);
    }
    .filter-label {
        font-size: 0.875rem;
        color: var(--foreground);
        white-space: nowrap;
    }
    .filter-buttons {
        display: flex;
        gap: 0.375rem;
        flex-wrap: wrap;
    }
    .filter-btn {
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--foreground);
        font-size: 0.8125rem;
        cursor: pointer;
        transition: all 0.2s ease;
        border-radius: 2px;
    }
    .filter-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
    }
    .filter-btn.active {
        background: var(--primary);
        border-color: var(--primary);
        color: var(--primary-foreground);
    }
    .weapon-empty {
        display: none;
        text-align: center;
        padding: 3rem 1rem;
        color: var(--muted-foreground);
        font-size: 1rem;
    }
</style>
