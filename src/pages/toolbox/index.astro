---
import Layout from "@/layouts/Layout.astro";
import ToolboxNav from "@/components/toolbox/ToolboxNav.astro";
---

<Layout title="工具箱 - MC521">
    <div class="gufeng-paper flex min-h-screen w-full flex-col overflow-x-hidden">
        <ToolboxNav title="工具箱" />
        <main class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-4 sm:px-6">
            <div class="py-8 md:py-12">
                <section class="mb-4 text-center">
                    <h1 class="gufeng-kai text-foreground mb-4 text-4xl font-medium sm:text-5xl">MC521 工具箱</h1>
                    <p class="gufeng-kai text-muted-foreground text-lg">玩服必备，方便快捷</p>
                </section>

                <div class="gufeng-divider text-muted-foreground mb-12">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                        ></path>
                    </svg>
                </div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <a href="/toolbox/damage-calc" class="gufeng-card group block p-6">
                        <h2 class="gufeng-kai text-foreground mb-2 text-xl font-medium">护甲减伤计算器</h2>
                        <p class="text-muted-foreground mb-6 text-sm">Minecraft 护甲减伤机制计算器，实时查看实际伤害</p>
                        <span class="gufeng-btn text-sm">打开工具</span>
                    </a>

                    <a href="/toolbox/skindrop" class="gufeng-card group block p-6">
                        <h2 class="gufeng-kai text-foreground mb-2 text-xl font-medium">换皮肤工具</h2>
                        <p class="text-muted-foreground mb-6 text-sm">上传并预览 Minecraft 皮肤，一键更换角色外观</p>
                        <span class="gufeng-btn text-sm">打开工具</span>
                    </a>

                    <div class="gufeng-card cursor-not-allowed p-6 opacity-50">
                        <h2 class="gufeng-kai text-foreground mb-2 text-xl font-medium">工单系统</h2>
                        <p class="text-muted-foreground mb-6 text-sm">暂未迁移</p>
                    </div>

                    <div class="gufeng-card cursor-not-allowed p-6 opacity-50">
                        <h2 class="gufeng-kai text-foreground mb-2 text-xl font-medium">正版验证</h2>
                        <p class="text-muted-foreground mb-6 text-sm">暂未迁移</p>
                    </div>
                </div>
            </div>
        </main>
    </div>
</Layout>
